{
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "phpstan/phpstan": "^2.2"
    },
    "autoload-dev": {
        "psr-4": {
            "Elros\\Testing\\Tests\\": "tests/"
        }
    },
    "autoload": {
        "psr-4": {
            "Elros\\Testing\\": "src/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse src tests --level=6"
    }
}
